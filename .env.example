# ==============================================================================
# Plantilla de Variables de Entorno - COMMUNITY 360
# Copiar a .env y completar con valores reales (nunca subir .env al repositorio)
# ==============================================================================

# 1. DataStax Astra DB (Apache Cassandra)
ASTRA_BUNDLE=ruta/al/secure-connect-proyecto.zip
ASTRA_TOKEN=AstraCS:tu_client_id:tu_client_secret
ASTRA_KEYSPACE=community360

# 2. Couchbase Capella
CB_CONEXION=couchbases://cb.ejemplo.cloud.couchbase.com
CB_USUARIO=usuario_couchbase
CB_CLAVE=clave_couchbase
CB_BUCKET=community360
CB_SCOPE=comunidad

# 3. Configuración de Firma JWT (Fase 3)
JWT_SECRET=reemplazar_por_secreto_hmac_sha256_de_al_menos_32_caracteres
JWT_ISSUER=Community360.Api
JWT_AUDIENCE=Community360.Web
JWT_EXP_MINUTES=120
